<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>fox.ico</ApplicationIcon>
    <AssemblyName>AirplayFox</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
    <Authors>Pritesh Kedar</Authors>
    <Description>Stream Windows system audio to a HomePod / AirPlay 2 speaker from the system tray.</Description>
    <Copyright>Copyright (c) 2026 Pritesh Kedar</Copyright>
    <RepositoryUrl>https://github.com/priteshkedar789/airplay-fox</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/priteshkedar789/airplay-fox</PackageProjectUrl>
    <PackageTags>airplay;airplay2;homepod;wasapi;windows</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="fox.ico" LogicalName="fox.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="plist-cil" Version="2.3.1" />
  </ItemGroup>

</Project>
